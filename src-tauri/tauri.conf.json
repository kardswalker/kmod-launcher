{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMod Launcher",
  "version": "0.1.0",
  "identifier": "com.kardswalker.kmodlauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "KMod Launcher",
      "width": 980,
      "height": 720,
      "minWidth": 720,
      "minHeight": 560,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
